@page "/Account/ForgotPassword"

@{
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<section class="account-page forgot-password-page">
    <div class="account-decoration">
        <span class="section-label">MOTOHUB MEMBER CARE</span>
        <h2>KHÔI PHỤC<br /><i>MẬT KHẨU.</i></h2>
        <p>Nhập email bạn đã dùng để đăng ký. Chúng tôi sẽ hướng dẫn bạn các bước tiếp theo.</p>
    </div>

    <div class="login-box">
        <span class="section-label">HỖ TRỢ TÀI KHOẢN</span>
        <h1>QUÊN MẬT KHẨU?</h1>
        <p class="account-description">Nhập địa chỉ email của bạn để bắt đầu khôi phục quyền truy cập.</p>

        <form id="forgotPasswordForm">
            <div class="form-group">
                <label for="recoveryEmail">Địa chỉ email</label>
                <input id="recoveryEmail"
                       name="Email"
                       type="email"
                       placeholder="Nhập email đã đăng ký"
                       autocomplete="email"
                       required />
            </div>
            <button type="submit" class="btn-gold">GỬI YÊU CẦU KHÔI PHỤC</button>
            <p id="recoveryMessage" class="recovery-message" role="status" aria-live="polite"></p>
        </form>

        <a asp-page="/Account/Login" class="back-home">← QUAY LẠI ĐĂNG NHẬP</a>
    </div>
</section>
