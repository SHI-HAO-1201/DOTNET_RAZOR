@page "/Contact"

@{
    ViewData["Title"] = "Liên hệ";
}

<section class="page-banner">
    <span class="section-label">LET'S CONNECT</span>
    <h1>KẾT NỐI VỚI MOTOHUB</h1>
    <p>
        Bạn cần tư vấn về sản phẩm hoặc dịch vụ?
        Đội ngũ MOTOHUB luôn sẵn sàng hỗ trợ.
    </p>
</section>

<section class="section contact">

    <div class="contact-layout">

        <!-- THÔNG TIN LIÊN HỆ -->
        <div class="contact-information">
            <span class="section-label">CONTACT INFORMATION</span>

            <h2>CHÚNG TÔI LUÔN <i>SẴN SÀNG</i></h2>

            <p class="contact-description">
                Hãy liên hệ với chúng tôi để được tư vấn
                về mẫu xe, chương trình ưu đãi và các dịch vụ
                tại hệ thống MOTOHUB.
            </p>

            <div class="contact-detail">
                <span>HOTLINE</span>
                <p>1900 0000</p>
            </div>

            <div class="contact-detail">
                <span>EMAIL</span>
                <p>support@motohub.vn</p>
            </div>

            <div class="contact-detail">
                <span>THỜI GIAN LÀM VIỆC</span>
                <p>08:00 – 20:00, tất cả các ngày</p>
            </div>
        </div>

        <!-- BIỂU MẪU LIÊN HỆ -->
        <form id="contactForm" class="contact-form">

            <span class="section-label">SEND US A MESSAGE</span>
            <h2>GỬI YÊU CẦU TƯ VẤN</h2>

            <div class="form-group">
                <label for="contactName">Họ và tên</label>
                <input id="contactName"
                       name="Name"
                       type="text"
                       placeholder="Nhập họ và tên"
                       required />
            </div>

            <div class="form-group">
                <label for="contactEmail">Địa chỉ email</label>
                <input id="contactEmail"
                       name="Email"
                       type="email"
                       placeholder="example@email.com"
                       required />
            </div>

            <div class="form-group">
                <label for="contactPhone">Số điện thoại</label>
                <input id="contactPhone"
                       name="Phone"
                       type="tel"
                       placeholder="Nhập số điện thoại" />
            </div>

            <div class="form-group">
                <label for="contactSubject">Chủ đề liên hệ</label>
                <input id="contactSubject"
                       name="Subject"
                       type="text"
                       placeholder="Ví dụ: Tư vấn mua xe"
                       required />
            </div>

            <div class="form-group">
                <label for="contactContent">Nội dung yêu cầu</label>
                <textarea id="contactContent"
                          name="Content"
                          rows="5"
                          placeholder="Chia sẻ nội dung bạn cần hỗ trợ..."
                          required></textarea>
            </div>

            <button type="submit" class="btn-submit">
                GỬI YÊU CẦU →
            </button>

            <p id="contactMessage" role="status"></p>

        </form>

    </div>

</section>
