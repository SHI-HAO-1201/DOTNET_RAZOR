@page "/Showroom"

@{
    ViewData["Title"] = "Hệ thống showroom";
}

<section class="page-banner">
    <span class="section-label">EXPERIENCE MOTOHUB</span>
    <h1>KHÔNG GIAN TRẢI NGHIỆM</h1>
    <p>
        Trực tiếp khám phá thiết kế, công nghệ
        và những mẫu mô tô tại MOTOHUB.
    </p>
</section>

<section class="section showroom-page">

    <div class="section-heading">
        <div>
            <span class="section-label">VISIT OUR SHOWROOMS</span>
            <h2>ĐIỂM ĐẾN <i>CỦA ĐAM MÊ</i></h2>
            <p>
                Đội ngũ MOTOHUB luôn sẵn sàng đón tiếp
                và hỗ trợ bạn lựa chọn mẫu xe phù hợp.
            </p>
        </div>
    </div>

    <div class="showroom-grid">

        <!-- SHOWROOM TP.HCM -->
        <article class="showroom-card">

            <div class="showroom-card-image">
                <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&amp;fit=crop&amp;w=1200&amp;q=85"
                     alt="Không gian showroom MOTOHUB tại TP. Hồ Chí Minh" />
            </div>

            <div class="showroom-card-content">
                <span class="section-label">SHOWROOM 01</span>

                <h3>MOTOHUB TP. HỒ CHÍ MINH</h3>

                <p>
                    <strong>Địa chỉ:</strong>
                    Cập nhật địa chỉ showroom.
                </p>

                <p>
                    <strong>Hotline:</strong>
                    1900 0000
                </p>

                <p>
                    <strong>Giờ hoạt động:</strong>
                    08:00 – 20:00
                </p>

                <a href="https://www.google.com/maps/search/?api=1&query=Ho+Chi+Minh+City"
                   target="_blank"
                   rel="noopener noreferrer">
                    XEM VỊ TRÍ TRÊN BẢN ĐỒ →
                </a>
            </div>

        </article>


        <!-- SHOWROOM HÀ NỘI -->
        <article class="showroom-card">

            <div class="showroom-card-image">
                <img src="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&amp;fit=crop&amp;w=1200&amp;q=85"
                     alt="Không gian showroom MOTOHUB tại Hà Nội" />
            </div>

            <div class="showroom-card-content">
                <span class="section-label">SHOWROOM 02</span>

                <h3>MOTOHUB HÀ NỘI</h3>

                <p>
                    <strong>Địa chỉ:</strong>
                    Cập nhật địa chỉ showroom.
                </p>

                <p>
                    <strong>Hotline:</strong>
                    1900 0000
                </p>

                <p>
                    <strong>Giờ hoạt động:</strong>
                    08:00 – 20:00
                </p>

                <a href="https://www.google.com/maps/search/?api=1&query=Ha+Noi"
                   target="_blank"
                   rel="noopener noreferrer">
                    XEM VỊ TRÍ TRÊN BẢN ĐỒ →
                </a>
            </div>

        </article>

    </div>

</section>
